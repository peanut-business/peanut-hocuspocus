# 复制为 docker/.env，设置权限为 0600，然后在 docker/ 目录执行 docker compose up -d。
# Compose 自动读取本文件；配置项均为名称、网络参数或摘要，无宿主机绝对路径。
# CA 和服务认证密钥放在与 docker/ 同级的 certs/ 目录，勿提交真实配置和密钥。
# 容器内监听地址、默认端口 80 和请求超时已固定在 compose.yaml，无需重复配置。

# 以下部署参数由部署者确定。

# Docker Compose 项目名称，用于标识和管理本服务容器。
COMPOSE_PROJECT_NAME=

# 服务加入的已有 Docker 网络名称，须能通过该网络访问 PHP API。
COLLABORATION_NETWORK=

# 宿主机对外端口，映射到容器内固定端口 80；默认 80:80，冲突时只改此值。
COLLABORATION_PORT=80

# Peanut PHP API 的 HTTPS 根地址，用于授权、加载和保存。
COLLABORATION_PHP_ORIGIN=

# 以下身份和摘要由应用配置提供；应用托管入口会自动写入，勿任意编造。

# Peanut 应用实例标识，必须与应用端配置一致。
COLLABORATION_INSTANCE_ID=

# 协作服务实例标识，必须与应用端配置一致；进程身份由程序另行生成。
COLLABORATION_SERVICE_INSTANCE_ID=

# 服务间认证密钥的编号；密钥内容单独保存在 service-secret 文件中。
COLLABORATION_KEY_ID=

# 应用版本类型，必须与应用端配置一致（engine、standalone 或 multi-tenant）。
COLLABORATION_EDITION=

# 应用认可的协作配置修订号。
COLLABORATION_CONFIG_REVISION=

# 应用认可的协作配置 SHA-256 摘要，勿自行生成另一份摘要替代。
COLLABORATION_CONFIG_SHA256=

# certs/ca.pem 文件的 SHA-256 摘要，服务启动时会校验。
COLLABORATION_CA_SHA256=
